<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">

    <TextView
        android:id="@+id/tv_titulo_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_menu"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_usuario_rol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/usuario_rol_formato"
        android:textSize="16sp"
        android:textColor="@color/gray_dark"
        android:layout_marginBottom="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_platos"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_platos"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/primary"
                app:icon="@android:drawable/ic_menu_agenda" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mesas"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_mesas"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/primary"
                app:icon="@android:drawable/ic_menu_sort_by_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pedidos"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_pedidos"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/primary"
                app:icon="@android:drawable/ic_menu_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reportes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_reportes"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/primary"
                app:icon="@android:drawable/ic_menu_view" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_salir"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/btn_salir"
        android:textSize="16sp"
        android:backgroundTint="@color/primary_dark" />

</LinearLayout>